{
  // -----------------------------------------------------------
  //              Item Obliterator by ElocinDev
  // -----------------------------------------------------------
  //  
  // How to add items?
  //   - They are json strings, so you need to separate each
  //     entry with a comma, except the last
  //   - If you start an entry with !, it will be treated as a regular expression
  //     Example: "!minecraft:.*_sword" to disable all swords
  //  
  // -----------------------------------------------------------
  // Do not touch this
  "configVersion": 2,
  // -----------------------------------------------------------
  // Items here will be unusable completely
  //    Example: minecraft:diamond
  "blacklisted_items": [
    "scguns:callwell_conversion", "scguns:callwell", "scguns:callwell_terminal",
    "scguns:saketini", "scguns:scrapper", "scguns:rusty_gnat", "scguns:callwell_conversion",
    "scguns:boomstick", "scguns:bruiser", "scguns:llr_director", "scguns:birdfeeder",
    "scguns:defender_pistol", "scguns:greaser_smg", "scguns:m3_carabine",
    "scguns:combat_shotgun", "scguns:brawler", "scguns:mk43_rifle", "scguns:ultra_knight_hawk",
    "scguns:floundergat", "scguns:mak_mkii", "scguns:killer_23", "scguns:kalaskah",
    "scguns:stigg", "scguns:krauser", "scguns:soul_drummer", "scguns:valora",
    "scguns:uppercut", "scguns:prush_gun", "scguns:lockewood", "scguns:shard_culler",
    "scguns:osgood_50", "scguns:grandle", "scguns:cogloader", "scguns:jackhammer",
    "scguns:howler_conversion", "scguns:spitfire", "scguns:gattaler", "scguns:thunderhead",
    "scguns:dozier_rl", "scguns:pyroclastic_flow", "scguns:freyr", "scguns:mangalitsa",
    "scguns:super_shotgun", "scguns:prima_materia", "scguns:carapice", "scguns:shellurker",
    "scguns:weevil", "scguns:raygun", "scguns:rat_king_and_queen", "scguns:locust",
    "scguns:newborn_cyst", "scguns:earths_corpse", "scguns:flayed_god", "scguns:terra_incognita",
    "scguns:antique_blueprint", "scguns:copper_blueprint", "scguns:iron_blueprint",
    "scguns:wrecker_blueprint", "scguns:treated_brass_blueprint", "scguns:diamond_steel_blueprint",
    "scguns:ocean_blueprint", "scguns:piglin_blueprint", "scguns:deep_dark_blueprint",
    "scguns:end_blueprint", "scguns:scorched_blueprint", "scguns:polar_generator", "scguns:lightning_rod_connector",
    "scguns:macerator", "scguns:powered_macerator", "scguns:powered_mechnical_press", "scguns:mechanical_press",
    "scguns:polar_generator", "scguns:gun_bench", "scguns:saketini_ironport", "scguns:winnie_millend",
    "scguns:winnie", "scguns:pax", "scguns:iron_spear", "scguns:rocket_rifle", "scguns:mokova",
    "scguns:stiletto", "scguns:homemaker", "scguns:micina", "scguns:rg_jigsaw", "scguns:inertial",
    "scguns:mas_55", "scguns:grandle_og",
    "createaddition:copper_wire", "createaddition:electrum_wire", "createaddition:spool", "createaddition:copper_spool",
    "createaddition:gold_spool", "createaddition:electrum_spool", "createaddition:festive_spool",
    "createaddition:rolling_mill", "createaddition:connector",
    "createaddition:small_light_connector", "createaddition:large_connector", "createaddition:redstone_relay",
    "createaddition:copperwire", "createaddition:portable_energy_interface",
    "copycats:copycat_slope", "copycats:copycat_vertical_slope", "copycats:copycat_slope_layer",
    "chemica:deepslate_silver_ore", "chemica:raw_silver", "chemica:silver_dust", "chemica:electrum_grit",
    "chemica:silver_nugget", "chemica:silver_ingot", "scguns:exo_suit_helmet", "scguns:exo_suit_chestplate", 
    "scguns:exo_suit_leggings", "scguns:exo_suit_boots", "scguns:exo_suit_core", "scguns:advanced_exo_suit_core",
    "scguns:night_vision_module", "scguns:target_tracker_module", "scguns:gas_mask_module", "scguns:rebreather_module",
    "scguns:jetpack_module", "scguns:rabbit_module", "scguns:suit_grease", "scguns:tension_spring", "scguns:shock_absorber",
    "scguns:armor_plate", "scguns:pauldron", "scguns:heavy_armor_plate", "scguns:heavy_pauldron", 
    "scguns:armor_pouches", "scguns:heavy_armor_pouches", "scguns:exo_suit_blueprint", "relics:elytra_booster", "scguns:netherite_bayonet",
    "create_enchantment_industry:printer", "create_enchantment_industry:enchanting_guide", "create_enchantment_industry:experience_rotor"
  
  ],
  // -----------------------------------------------------------
  // Removes an item if it contains certain nbt tag. If the whole entry (or expression) is present, the item gets removed.
  // Use with caution! This is a very expensive operation and can cause lag if you have a lot of items blacklisted.
  // 	
  // 	 Example to disable a regeneration potion: Potion:"minecraft:regeneration"
  // 	
  // 	 You can also use regular expressions by starting the value with !
  "blacklisted_nbt": [],
  // -----------------------------------------------------------
  // Items here will not be able to be right-clicked (Interact)
  //    Example: minecraft:apple
  "only_disable_interactions": [
    "examplemod:example_item"
  ],
  // -----------------------------------------------------------
  // Items here will not be able to be used to attack
  //    Example: minecraft:diamond_sword
  "only_disable_attacks": [
    "examplemod:example_item"
  ],
  // -----------------------------------------------------------
  // Items here will get their recipes disabled
  // Keep in mind this already is applied to blacklisted items
  "only_disable_recipes": [
    "examplemod:example_item"
  ],
  // -----------------------------------------------------------
  // If true, the mod will use a hashset to handle the blacklisted items
  // This is a more optimized approach only if you have a lot of items blacklisted (20 or more is recommended)
  // If you just have a small amount of items blacklisted, keep this false
  //  
  // [!] Enabling this will disable all regular expressions
  // [!] Does not apply to NBT, only item blacklist / interaction / attack
  "use_hashmap_optimizations": true
}