// kubejsstudio loot tables; re-apply merges by table id
ServerEvents.generateData('after_mods', event => {
    event.json('lootjs:loot_table/robotic_drops', {"type":"minecraft:chest","random_sequence":"lootjs:robotic_drops","pools":[{"rolls":1.0,"bonus_rolls":0.0,"entries":[{"functions":[{"count":{"min":2.0,"max":5.0,"type":"minecraft:uniform"},"add":false,"function":"minecraft:set_count"}],"name":"minecraft:iron_nugget","weight":10,"type":"minecraft:item"},{"name":"scguns:depleted_energy_core","weight":5,"type":"minecraft:item"},{"name":"minecraft:iron_ingot","weight":5,"type":"minecraft:item"},{"name":"scguns:energy_core","type":"minecraft:item"},{"type":"minecraft:item","name":"kubejs:robotic_ichor_cell","weight":3,"functions":[{"function":"minecraft:set_count","count":2}]}]}]})
    event.json('minecraft:loot_table/blocks/stone', {"type":"minecraft:block","random_sequence":"minecraft:blocks/stone","pools":[{"rolls":1.0,"bonus_rolls":0.0,"name":"main","entries":[{"type":"minecraft:alternatives","children":[{"conditions":[{"predicate":{"predicates":{"minecraft:enchantments":[{"enchantments":"minecraft:silk_touch","levels":{"min":1}}]}},"condition":"minecraft:match_tool"}],"name":"minecraft:stone","type":"minecraft:item"},{"conditions":[{"condition":"minecraft:survives_explosion"}],"name":"minecraft:cobblestone","type":"minecraft:item"}]},{"type":"minecraft:item","name":"kubejs:common_geode","weight":1,"conditions":[{"condition":"minecraft:random_chance_with_enchanted_bonus","enchantment":"minecraft:fortune","unenchanted_chance":0.1,"enchanted_chance":0.3}]}]}]})
    event.json('minecraft:loot_table/blocks/deepslate', {"type":"minecraft:block","random_sequence":"minecraft:blocks/deepslate","pools":[{"rolls":1.0,"bonus_rolls":0.0,"name":"main","entries":[{"type":"minecraft:alternatives","children":[{"conditions":[{"predicate":{"predicates":{"minecraft:enchantments":[{"enchantments":"minecraft:silk_touch","levels":{"min":1}}]}},"condition":"minecraft:match_tool"}],"name":"minecraft:deepslate","type":"minecraft:item"},{"conditions":[{"condition":"minecraft:survives_explosion"}],"name":"minecraft:cobbled_deepslate","type":"minecraft:item"}]},{"type":"minecraft:item","name":"kubejs:deep_geode","conditions":[{"condition":"minecraft:random_chance_with_enchanted_bonus","enchantment":"minecraft:fortune","unenchanted_chance":0.1,"enchanted_chance":0.3}]}]}]})
})
